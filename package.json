{
  "name": "drillhall",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run validate -w packages/content",
    "db:generate": "npm run db:generate -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server",
    "start": "npm run start -w apps/server",
    "e2e:server": "node scripts/e2e-server.mjs",
    "e2e": "npm run build -w apps/client && playwright test -c apps/client/playwright.config.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
