# Copy to .env at the repo root and fill in. See SECRETS.md for how each is obtained/rotated.

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the server (what browsers hit). On the VM this is your tailnet name.
# Dev default is http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (optional — the Google sign-in button hides itself when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional — verification emails log to stdout when unset)
RESEND_API_KEY=
EMAIL_FROM=CompTIA Prep <onboarding@resend.dev>

# SQLite database file (resolved relative to apps/server/)
DATABASE_URL=file:./data/app.db

# Extra allowed browser origins, comma-separated (Vite dev origin is always allowed in dev)
TRUSTED_ORIGINS=

PORT=3001
